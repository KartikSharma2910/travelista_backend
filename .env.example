# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelista_db?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Optional: AI Services (if integrated)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Email Service
EMAIL_SERVICE=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional: File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Optional: Stripe (for payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
